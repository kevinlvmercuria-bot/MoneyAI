APP_PORT=3000
APP_HOST=127.0.0.1
# Local PostgreSQL or Neon connection string; keep credentials out of Git.
DATABASE_URL=postgresql://nailmate:replace-with-password@127.0.0.1:5432/nailmate

# WeCom customer contact application (not an internal notification bot).
WECOM_CORP_ID=
WECOM_CONTACT_SECRET=
# WeChat Customer Service application and encrypted callback configuration.
WECOM_KF_SECRET=
WECOM_CALLBACK_TOKEN=
WECOM_CALLBACK_AES_KEY=
# Optional: stable Base64-encoded 32-byte key for database-stored WeCom settings.
# Required on hosts with ephemeral disks; keep it in the hosting secret store.
WECOM_SETTINGS_KEY=

# Only the one-time SQL Server migration tool uses these settings.
SQLSERVER_HOST=localhost
SQLSERVER_INSTANCE=SQLEXPRESS01
SQLSERVER_NAME=NailMate
SQLSERVER_AUTH=windows
SQLSERVER_USER=
SQLSERVER_PASSWORD=
SQLSERVER_ENCRYPT=false
SQLSERVER_TRUST_SERVER_CERTIFICATE=true

# AI 密钥仅保存在本机 .env
AI_API_KEY=
AI_BASE_URL=https://moma.cmecloud.cn/tokenplan-personal
AI_MODEL=Qwen/Qwen3.6-Flash
