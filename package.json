{
  "name": "nailmate",
  "version": "4.0.0",
  "private": true,
  "description": "NailMate Express API and SQL Server integration scaffold",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "node server/main.js",
    "dev": "node --watch server/main.js",
    "db:init": "node database/setup.js",
    "test": "node --test server/workflow.test.js server/relationship.test.js server/communication.test.js database/personality-notes.test.js",
    "check": "node scripts/check.js",
    "test:legacy": "node --test server/app.test.js",
    "db:import": "node database/import-source.js",
    "db:personality-notes": "node database/personality-notes.js",
    "build:share": "node scripts/build-share.js",
    "test:team": "node --test server/team.test.js"
  },
  "dependencies": {
    "dotenv": "18.0.9",
    "express": "5.3.0",
    "mssql": "12.7.14"
  },
  "optionalDependencies": {
    "msnodesqlv8": "^5.0.0"
  }
}
